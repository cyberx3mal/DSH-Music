{
  "name": "@local/music-board",
  "version": "1.2.6",
  "private": true,
  "description": "Left-sidebar music widget: all Windows media sources in a now-playing card with cover art, per-app volume, seek, audio-reactive equalizer, and a collapsible strip. Cover art uses Apple iTunes, Deezer and MusicBrainz/Cover Art Archive with generated fallback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberx3mal/DSH-Music.git"
  },
  "homepage": "https://github.com/cyberx3mal/DSH-Music#readme",
  "bugs": {
    "url": "https://github.com/cyberx3mal/DSH-Music/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "smtc-watcher.ps1",
    "music-helper.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/preview.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
